{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareScout",
  "version": "0.6.0",
  "identifier": "com.sharescout.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShareScout",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../sharescout.png"
    ]
  }
}
